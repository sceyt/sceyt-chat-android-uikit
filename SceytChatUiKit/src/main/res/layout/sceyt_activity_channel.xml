<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sceyt_color_background"
    tools:context=".presentation.components.channel.messages.ChannelActivity">

    <com.sceyt.chatuikit.presentation.components.channel.header.MessagesListHeaderView
        android:id="@+id/headerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sits between the toolbar and the list rather than inside MessagesListView: the
         list's RecyclerView is an unconstrained match_parent, so a banner nested there
         would overlay the messages instead of pushing them down. -->
    <com.sceyt.chatuikit.presentation.components.channel.messages.components.PinnedMessagesView
        android:id="@+id/pinnedMessagesView"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/headerView"
        tools:visibility="visible" />

    <com.sceyt.chatuikit.presentation.components.channel.messages.MessagesListView
        android:id="@+id/messagesListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/messageInputView"
        app:layout_constraintTop_toBottomOf="@+id/pinnedMessagesView" />

    <com.sceyt.chatuikit.presentation.components.channel.input.MessageInputView
        android:id="@+id/messageInputView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
