<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/pinForAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:contentDescription="@string/sceyt_pin_for_all"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="@string/sceyt_pin_for_all"
        android:textColor="@color/sceyt_color_text_primary"
        android:textSize="16sp"
        tools:text="Pin for all" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/pinForMe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:contentDescription="@string/sceyt_pin_for_me"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="@string/sceyt_pin_for_me"
        android:textColor="@color/sceyt_color_text_primary"
        android:textSize="16sp"
        tools:text="Pin for me" />

</androidx.appcompat.widget.LinearLayoutCompat>
